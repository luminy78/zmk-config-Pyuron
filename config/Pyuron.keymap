#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        JK_LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
            timeout-ms = <30>;
            layers = <0>;
            require-prior-idle-ms = <150>;
            slow-release;
        };

        KL_RightClick {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            slow-release;
            layers = <0>;
        };

        UI_MiddleClick {
            bindings = <&mkp MB3>;
            key-positions = <6 7>;
            timeout-ms = <30>;
            require-prior-idle-ms = <150>;
            slow-release;
            layers = <0>;
        };

        FD_LeftClick {
            bindings = <&mkp MB1>;
            key-positions = <13 12>;
            timeout-ms = <30>;
            slow-release;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        DS_RightClick {
            bindings = <&mkp MB2>;
            key-positions = <11 12>;
            timeout-ms = <30>;
            slow-release;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        RE_MiddleClick {
            bindings = <&mkp MB3>;
            key-positions = <2 3>;
            timeout-ms = <30>;
            slow-release;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    lt_to_layer_0: lt_to_layer_0 {
        compatible = "zmk,behavior-hold-tap";
        label = "LAYER_TAP_TO_0";
        bindings = <&mo>, <&to_layer_0>;

        #binding-cells = <2>;
        tapping-term-ms = <200>;
    };

    LANG12_TapDance: LANG12_TapDance {
        compatible = "zmk,behavior-tap-dance";
        label = "LANG12_TAPDANCE";
        #binding-cells = <0>;
        bindings = <&kp LANGUAGE_2>, <&kp LANG1>;
    };
};

/ {
    behaviors {
    };

    keymap {
        compatible = "zmk,keymap";

        Default {
            bindings = <
&kp Q             &kp W                 &kp E         &kp R         &kp T                  &kp Y        &kp U      &kp I                  &kp O       &kp P
&mt LCTRL A       &kp S                 &kp D         &kp F         &kp G                  &kp H        &kp J      &kp K                  &kp L       &mt RCTRL MINUS
&mt LEFT_SHIFT Z  &kp X                 &kp C         &kp V         &kp B                  &lt 4 TAB    &kp LANG2  &kp N                  &kp M       &kp COMMA
&kp DOT           &mt RIGHT_SHIFT INT1  &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 INTERNATIONAL_5  &lt 3 SPACE  &kp LANG1  &lt 1 INTERNATIONAL_4  &kp ESCAPE  &kp DEL
            >;
        };

        Move+Sound {
            bindings = <
&trans          &trans          &kp UP_ARROW    &trans        &trans   &trans  &trans     &trans  &trans             &trans
&mt LCTRL HOME  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT     &kp END  &trans  &kp ENTER  &trans  &trans             &trans
&kp LEFT_SHIFT  &trans          &trans          &trans        &trans   &trans  &trans     &trans  &trans             &trans
&trans          &kp K_MUTE      &kp LEFT_WIN    &kp LEFT_ALT  &trans   &trans  &trans     &trans  &kp C_VOLUME_DOWN  &kp C_VOL_UP
            >;
        };

        Number {
            bindings = <
&trans          &trans      &trans        &trans         &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_MINUS     &kp KP_DIVIDE
&kp LCTRL       &trans      &trans        &kp BACKSPACE  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp KP_ASTERISK
&kp LEFT_SHIFT  &trans      &trans        &trans         &trans  &trans           &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&kp KP_EQUAL    &kp KP_DOT  &kp LEFT_GUI  &kp LEFT_ALT   &trans  &trans           &trans           &kp KP_NUMBER_0  &trans           &trans
            >;
        };

        Symbol {
            bindings = <
&kp EXCLAMATION         &kp QUESTION  &trans        &trans        &trans  &kp ASTERISK     &kp LEFT_PARENTHESIS  &kp SLASH          &kp LS(INT3)   &kp INT3
&mt LCTRL LEFT_BRACKET  &kp HASH      &kp DLLR      &trans        &trans  &kp RIGHT_BRACE  &kp PIPE              &trans             &kp CARET      &kp PLUS
&kp LEFT_SHIFT          &trans        &trans        &trans        &trans  &trans           &trans                &kp RIGHT_BRACKET  &kp BACKSLASH  &trans
&trans                  &trans        &kp LEFT_GUI  &kp LEFT_ALT  &trans  &trans           &trans                &trans             &trans         &trans
            >;
        };

        Fn+Setting {
            bindings = <
&kp F11  &kp F12  &kp F13  &kp F14  &kp F15      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4
&kp F6   &kp F7   &kp F8   &kp F9   &kp F10      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4
&kp F1   &kp F2   &kp F3   &kp F4   &kp F5       &trans         &trans         &trans         &trans         &trans
&trans   &trans   &trans   &trans   &bootloader  &sys_reset     &sys_reset     &bootloader    &bt BT_CLR     &bt BT_CLR_ALL
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
